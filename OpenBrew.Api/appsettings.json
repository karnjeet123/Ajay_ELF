{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "OpenBrewery": "Data Source=openbrewery.db"
  },
  "OpenBrewery": {
    "BaseUrl": "https://api.openbrewerydb.org/v1/",
    "CacheDurationMinutes": 10,
    "PerPage": 200,
    "MaxPagesToFetch": 10
  },
  "AllowedHosts": "*"
}
